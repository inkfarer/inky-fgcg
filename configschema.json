{
    "$schema": "http://json-schema.org/draft-07/schema",
    "type": "object",
    "required": ["startgg"],
    "properties": {
        "event": {
            "type": "object",
            "properties": {
                "timezone": { "type": "string" },
                "location": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "startgg": {
            "type": "object",
            "additionalProperties": false,
            "required": ["apiKey"],
            "properties": {
                "apiKey": { "type": "string" }
            }
        }
    }
}
