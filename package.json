{
    "name": "inky-fgcg",
    "version": "0.1.0",
    "description": "inky's Fighting Game Character Generator",
    "author": {
        "name": "inkfarer",
        "email": "inkfarer@inkfarer.com",
        "url": "https://inkfarer.com"
    },
    "scripts": {
        "build:clean": "run-s clean build",
        "build": "run-p build:browser build:extension",
        "build:browser": "vite --config vite.config.browser.mjs build",
        "build:extension": "vite --config vite.config.extension.ts build",
        "clean": "trash node_modules/.cache && trash dashboard && trash graphics && trash shared && trash extension",
        "start": "node ../..",
        "watch": "run-p watch:*",
        "watch:browser": "vite --config vite.config.browser.mjs",
        "watch:extension": "vite --config vite.config.extension.ts",
        "schema-types": "nodecg schema-types"
    },
    "nodecg": {
        "compatibleRange": "^1.7.0 || ^2.0.0",
        "dashboardPanels": [
            {
                "name": "entrant-import",
                "title": "Entrant Import",
                "width": 2,
                "file": "entrant-import.html",
                "workspace": "2 - Setup",
                "headerColor": "#262F40"
            },
            {
                "name": "settings",
                "title": "Settings",
                "width": 2,
                "file": "settings.html",
                "workspace": "2 - Setup",
                "headerColor": "#262F40"
            },
            {
                "name": "next-match",
                "title": "Next Match",
                "width": 2,
                "file": "next-match.html",
                "workspace": "1 - Main",
                "headerColor": "#262F40"
            },
            {
                "name": "active-match",
                "title": "Active Match",
                "width": 2,
                "file": "active-match.html",
                "workspace": "1 - Main",
                "headerColor": "#262F40"
            },
            {
                "name": "intermission",
                "title": "Intermission",
                "width": 2,
                "file": "intermission.html",
                "workspace": "1 - Main",
                "headerColor": "#262F40"
            },
            {
                "name": "brackets",
                "title": "Brackets",
                "width": 2,
                "file": "brackets.html",
                "workspace": "1 - Main",
                "headerColor": "#262F40"
            },
            {
                "name": "casters",
                "title": "Casters",
                "width": 2,
                "file": "casters.html",
                "workspace": "1 - Main",
                "headerColor": "#262F40"
            }
        ],
        "graphics": [
            {
                "file": "gameplay.html",
                "width": 1920,
                "height": 1080
            },
            {
                "file": "bottom-bar.html",
                "width": 1920,
                "height": 1080
            },
            {
                "file": "bracket.html",
                "width": 1920,
                "height": 1080
            },
            {
                "file": "caster-display.html",
                "width": 1920,
                "height": 1080
            },
            {
                "file": "intermission.html",
                "width": 1920,
                "height": 1080
            },
            {
                "file": "background.html",
                "width": 1920,
                "height": 1080
            }
        ],
        "assetCategories": [
            {
                "name": "sponsors",
                "title": "Sponsor Logos",
                "allowedTypes": [
                    "jpg",
                    "jpeg",
                    "png",
                    "gif"
                ]
            }
        ]
    },
    "repository": "https://github.com/nodecg/nodecg.git",
    "devDependencies": {
        "@fortawesome/fontawesome-svg-core": "7.0.0",
        "@fortawesome/free-brands-svg-icons": "7.0.0",
        "@fortawesome/free-solid-svg-icons": "7.0.0",
        "@fortawesome/vue-fontawesome": "3.1.1",
        "@iplsplatoon/vue-components": "3.3.2",
        "@nodecg/types": "^2.1.11",
        "@tourneyview/common": "~0.7.0",
        "@tourneyview/importer": "~0.7.1",
        "@tourneyview/renderer": "~0.7.0",
        "@types/d3": "^7.4.3",
        "@types/lodash": "^4.14.171",
        "@types/luxon": "^3.4.2",
        "@types/node": "^15.14.9",
        "@types/uuid": "^9.0.8",
        "@vitejs/plugin-vue": "^4.4.0",
        "@vue/compiler-sfc": "^3.3.7",
        "gsap": "3.12.5",
        "lodash": "^4.17.21",
        "npm-run-all": "^4.1.5",
        "pinia": "^2.1.7",
        "sass": "^1.69.5",
        "trash-cli": "^5.0.0",
        "typescript": "^5.4.5",
        "vite": "^4.5.0",
        "vite-plugin-checker": "^0.6.4",
        "vite-plugin-nodecg": "2.0.0-rc3",
        "vite-tsconfig-paths": "^4.3.2",
        "vue": "^3.3.7",
        "vue-tsc": "^1.8.27",
        "vuedraggable": "^4.1.0"
    },
    "dependencies": {
        "axios": "^1.6.8",
        "d3": "^7.9.0",
        "luxon": "^3.4.4",
        "pixi.js": "^8.6.6",
        "uuid": "^10.0.0"
    }
}
