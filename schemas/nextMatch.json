{
    "$schema": "http://json-schema.org/draft-07/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "entrantA": {
            "$ref": "defs/entrant.json#/entrant"
        },
        "entrantB": {
            "$ref": "defs/entrant.json#/entrant"
        },
        "match": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "name": {
                    "type": "string"
                },
                "numberOfGames": {
                    "type": "number"
                },
                "playType": {
                    "$ref": "defs/playType.json#/playType"
                }
            },
            "required": ["name", "numberOfGames", "playType"]
        }
    },
    "required": ["entrantA", "entrantB", "match"],
    "default": {
        "entrantA": {
            "id": "000",
            "name": "Placeholder Entrant 1",
            "participants": [
                {
                    "id": "0001",
                    "name": "Placeholder Entrant 1"
                }
            ]
        },
        "entrantB": {
            "id": "111",
            "name": "Placeholder Entrant 2",
            "participants": [
                {
                    "id": "1111",
                    "name": "Placeholder Entrant 2"
                }
            ]
        },
        "match": {
            "name": "Next Placeholder Round",
            "numberOfGames": 3,
            "playType": "BEST_OF"
        }
    }
}
