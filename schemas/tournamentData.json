{
    "$schema": "http://json-schema.org/draft-07/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "name": {
            "type": "string"
        },
        "slug": {
            "type": "string"
        },
        "eventId": {
            "type": "number"
        }
    },
    "required": ["name"],
    "default": {
        "name": "Placeholder Tournament"
    }
}
