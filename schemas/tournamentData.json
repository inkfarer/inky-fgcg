{
    "$schema": "http://json-schema.org/draft-07/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "name": {
            "type": "string"
        },
        "source": {
            "type": "string",
            "enum": ["startgg", "unknown"]
        },
        "sourceSpecificData": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "startgg": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["slug", "eventId", "streams"],
                    "properties": {
                        "slug": {
                            "type": "string"
                        },
                        "eventId": {
                            "type": "number"
                        },
                        "streams": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "id": {
                                        "type": "number"
                                    },
                                    "streamName": {
                                        "type": "string"
                                    }
                                },
                                "additionalProperties": false,
                                "required": ["id", "streamName"]
                            }
                        }
                    }
                }
            }
        }
    },
    "required": ["name", "source"],
    "default": {
        "name": "Placeholder Tournament",
        "source": "unknown"
    }
}
