{
    "$schema": "http://json-schema.org/draft-07/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "flavorText": {
            "type": "string"
        },
        "mode": {
            "type": "string",
            "enum": ["EMPTY", "FLAVOR_TEXT", "ACTIVE_MATCH", "NEXT_MATCH"]
        }
    },
    "required": ["flavorText", "mode"],
    "default": {
        "flavorText": "Welcome to the stream!",
        "mode": "FLAVOR_TEXT"
    }
}
