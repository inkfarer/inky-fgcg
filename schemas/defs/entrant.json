{
    "$schema": "http://json-schema.org/draft-07/schema",
    "entrant": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
            "id": {
                "type": "string"
            },
            "name": {
                "type": "string"
            },
            "participants": {
                "type": "array",
                "items": {
                    "$ref": "participant.json#/participant"
                }
            }
        },
        "required": ["id", "name", "participants"]
    }
}
