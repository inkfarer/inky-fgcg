{
    "$schema": "http://json-schema.org/draft-07/schema",
    "participant": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
            "id": {
                "type": "string"
            },
            "name": {
                "type": "string"
            },
            "prefix": {
                "type": ["string", "null"]
            }
        },
        "required": ["id", "name"]
    }
}
