{
    "$schema": "http://json-schema.org/draft-07/schema",
    "definitions": {
        "activeMatchEntrant": {

        }
    },
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "entrants": {
            "type": "array",
            "items": {
                "allOf": [
                    {
                        "$ref": "defs/entrant.json#/entrant"
                    },
                    {
                        "type": "object",
                        "properties": {
                            "score": {
                                "type": "number"
                            }
                        },
                        "required": ["score"]
                    }
                ]
            }
        },
        "match": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "name": {
                    "type": "string"
                },
                "numberOfGames": {
                    "type": "number"
                },
                "playType": {
                    "$ref": "defs/playType.json#/playType"
                }
            },
            "required": ["name", "numberOfGames", "playType"]
        }
    },
    "required": ["entrants", "match"],
    "default": {
        "entrants": [
            {
                "id": "000",
                "name": "Placeholder Entrant 1",
                "score": 0,
                "participants": [
                    {
                        "id": "0001",
                        "name": "Placeholder Entrant 1"
                    }
                ]
            },
            {
                "id": "111",
                "name": "Placeholder Entrant 2",
                "score": 0,
                "participants": [
                    {
                        "id": "1111",
                        "name": "Placeholder Entrant 2"
                    }
                ]
            }
        ],
        "match": {
            "name": "Placeholder Round",
            "numberOfGames": 3,
            "playType": "BEST_OF"
        }
    }
}
